# Set on CloudCannon and on the production host. Leave the domain empty to use coffee.mock.shop, Shopify's sample coffee catalog.
# The Storefront API token is public by design: it reaches the browser for cart calls.
PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
PUBLIC_SHOPIFY_API_VERSION=2026-10

# CloudCannon build only. Renders placeholders and notes for parts that aren't edited in CloudCannon.
# PUBLIC_EDITOR_BUILD=true
