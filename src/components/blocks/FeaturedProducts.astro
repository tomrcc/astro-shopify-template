---
import type { BlockProps } from '../../content.config';
import type { ProductCard as Card } from '../../lib/shopify/types';
import ProductCard from '../shop/ProductCard.astro';
import catalog from '../../data/shopify/products.json';

type Props = BlockProps<'featured_products'>;

const { heading, intro, products, button } = Astro.props;
// Reads the synced catalog, not the API, so the block re-renders in the Visual Editor.
const cards = (products ?? [])
	.map((handle) => (catalog as Card[]).find((product) => product.handle === handle))
	.filter((product): product is Card => Boolean(product));
---
<section class="section">
	{heading && <h2 data-editable="text" data-prop="heading">{heading}</h2>}
	{intro && <p class="section-intro" data-editable="text" data-prop="intro">{intro}</p>}
	<ul class="product-grid">
		{cards.map((product) => (
			<li><ProductCard product={product} /></li>
		))}
	</ul>
	{button?.label?.trim() && (
		<a class="button button-quiet" href={button.url || '/'} data-editable="text" data-prop="button.label">{button.label}</a>
	)}
</section>
