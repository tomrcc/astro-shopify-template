---
import { editorBuild } from '../lib/editor-build';

interface Props {
	note?: string;
}
const { note } = Astro.props;
---
{editorBuild && (
	<span class="editor-note">
		<button type="button" class="editor-note-icon" aria-expanded="false" aria-label="About this part">
			<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<rect x="3" y="4" width="18" height="7" rx="2" /><rect x="3" y="13" width="18" height="7" rx="2" />
				<path d="M7 7.5h.01M7 16.5h.01" />
			</svg>
		</button>
		<span class="editor-note-text" role="tooltip">{note || "This part isn't edited in CloudCannon."}</span>
		{/* Inline so the badge's CSS and JS ship only in the editor build. */}
		<style is:inline>
			[data-editor-mode] :has(> .editor-note) {
				position: relative;
				outline: 1px dashed rgb(124 58 237 / 0.45);
				outline-offset: 6px;
			}
			.editor-note {
				display: none;
			}
			[data-editor-mode] .editor-note {
				display: block;
				position: absolute;
				top: -0.75rem;
				right: -0.75rem;
				z-index: 10;
				font: 0.8125rem/1.4 system-ui, sans-serif;
			}
			.editor-note-icon {
				display: grid;
				place-items: center;
				width: 1.75rem;
				height: 1.75rem;
				padding: 0;
				border: 0;
				border-radius: 50%;
				background: #7c3aed;
				color: #fff;
				cursor: help;
			}
			.editor-note-text {
				display: none;
				position: absolute;
				top: 2.25rem;
				right: 0;
				width: max-content;
				max-width: 16rem;
				padding: 0.5rem 0.75rem;
				border-radius: 0.375rem;
				background: #1f1235;
				color: #fff;
				text-align: left;
			}
			.editor-note:hover .editor-note-text,
			.editor-note-icon[aria-expanded='true'] + .editor-note-text {
				display: block;
			}
		</style>
		<script is:inline>
			(() => {
				// The editor build is also served outside the Visual Editor, where notes stay hidden.
				// inEditorMode can be set after this runs, so check again once the page loads.
				const markEditor = () => {
					if (window.inEditorMode) document.documentElement.setAttribute('data-editor-mode', '');
				};
				markEditor();
				document.addEventListener('DOMContentLoaded', markEditor);
				window.addEventListener('load', markEditor);

				const button = document.currentScript.parentElement.querySelector('.editor-note-icon');
				button.addEventListener('click', () => {
					button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true'));
				});
			})();
		</script>
	</span>
)}
